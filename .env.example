# Optional. Leave blank for the fully functional, local-only application.
# The anon key is public; RLS is mandatory. NEVER put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only enable after adding your own android/app/google-services.json.
VITE_PUSH_ENABLED=false
# No exchange-rate API key is needed; manual rates are the default.
